import { useState } from 'react';
import axios from 'axios';

export default function QuizPage() {
  const [quiz, setQuiz] = useState(null);
  
  const generateQuiz = async (subject, grade) => {
    const response = await axios.post('https://your-fastapi-backend.herokuapp.com/generate-quiz', {
      subject,
      grade
    });
    setQuiz(response.data);
  };

  return (
    <div>
      <h1>AI Quiz Generator</h1>
      <button onClick={() => generateQuiz('Math', 6)}>Generate Math Quiz</button>
      {quiz && <div>{/* Render quiz questions */}</div>}
    </div>
  );
}
